[Unit]
Description=GWADM broadcast queue processor
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/deploy/gwadm
Environment=PATH=/home/deploy/gwadm/venv/bin
EnvironmentFile=-/home/deploy/gwadm/.env
ExecStart=/home/deploy/gwadm/venv/bin/python /home/deploy/gwadm/scripts/process_broadcast_queue.py

[Install]
WantedBy=default.target
