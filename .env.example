# Скопируйте в .env на сервере: cp .env.example .env && nano .env
# SECRET_KEY должен быть одинаковым для всех воркеров gunicorn (иначе сессии «вылетают»).
SECRET_KEY=сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"

# Обязательно на проде:
GWARS_PASSWORD=           # пароль подписей GWars (без него callback /login не работает на production)
ENABLE_DEV_LOGIN=0        # отключить /login/dev на проде

# Обязательно на проде (cron-job.org и /cron/run):
CRON_SECRET_TOKEN=         # сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Опционально (есть dev-дефолты для локальной разработки):
# DATABASE_PATH=           # путь к SQLite (по умолчанию: database.db в корне репозитория)
# BACKUP_DIR=              # каталог бэкапов (по умолчанию: backups/ рядом с database.db)
# FLASK_ENV=production     # production-режим (уровень логов INFO)
# FLASK_DEBUG=1            # подробные логи (только локально)
# EVENT_TIME_OFFSET_HOURS=3
# MONITOR_DISK_WARN_PERCENT=85
# MONITOR_DISK_CRIT_PERCENT=95
# MONITOR_AVATAR_WARN_MB=500
# MONITOR_AVATAR_CRIT_MB=1000
# MONITOR_SKIP_PUBLIC=1          # только local /health (без curl https://gwadm.ru)
